<h1><%= @article.title %></h1>
<p>Published on <%= publication_date(@article) %></p>
<p><%= @article.body %></p>

<% if authenticated? && @article.user_id == Current.user.id %>
<ul>
  <li><%= link_to "Edit", edit_article_path(@article) %></li>
  <li><%= link_to "Destroy", article_path(@article), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %></li>
</ul>
<% end %>

<h2>Comments</h2>

<%= button_to(
  @show_comments ? "Hide comments" : "Show comments",
  comment_visibility_article_path(@article),
  method: :patch,
  params: { show_comments: @show_comments ? "false" : "true" }
) %>

<% if @show_comments %>
  <% @article.comments.each do |comment| %>
    <% next unless comment.persisted? %>

    <p>
      <strong>Commenter:</strong>
      <%= comment.commenter %>
    </p>

    <p>
      <strong>Comment:</strong>
      <%= comment.body %>
    </p>
  <% end %>
<% end %>

<h2>Add a comment:</h2>
<%= form_with model: [ @article, @comment] do |form| %>
  <p>
    <%= form.label :commenter %><br>
    <%= form.text_field :commenter %>
  </p>
  <p>
    <%= form.label :body %><br>
    <%= form.text_area :body %>
  </p>
  <% @comment.errors.full_messages.each do |message| %>
  <p><%= message %></p>
<% end %>

  <p>
    <%= form.submit %>
  </p>
<% end %>
